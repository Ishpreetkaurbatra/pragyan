# T→G (Trend to Growth) Environment Configuration

APP_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# Database configuration (PostgreSQL + pgvector)
# By default in DATA_MODE=demo, the app initializes full rich seed data in-memory/file store
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tgotg
DIRECT_DATABASE_URL=

# Authentication
AUTH_MODE=demo
JWT_SECRET=tg-secret-jwt-key-growth-works-2025

# Storage
STORAGE_MODE=local
STORAGE_BASE_PATH=./storage

# Operational Modes
DATA_MODE=demo
INTELLIGENCE_MODE=mock

# Local AI runtime (when INTELLIGENCE_MODE=local)
AI_RUNTIME=ollama
AI_BASE_URL=http://localhost:11434
AI_MODEL=llama3.1:8b
AI_VERSION=8b-instruct

# Embeddings & Reranking (Local/Open models)
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=bge-reranker-base

# Future T→G Dedicated Model (when INTELLIGENCE_MODE=tgo)
TGO_AI_BASE_URL=
TGO_AI_API_KEY=
TGO_AI_MODEL=tgo-growth-8b
TGO_AI_VERSION=tgo-v1

LOG_LEVEL=info
