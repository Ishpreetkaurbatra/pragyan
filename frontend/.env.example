# T→G (Trend to Growth) Frontend Environment Configuration

# Production backend API base URL (e.g. https://your-backend-service.onrender.com)
# In Vercel, configure this under: Project Settings -> Environment Variables -> VITE_API_BASE_URL
# During local development, leave this empty to use the Vite local proxy (http://127.0.0.1:4000)
VITE_API_BASE_URL=
