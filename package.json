{
  "name": "t-to-g-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "description": "T→G (Trend to Growth) - Complete Full-Stack Business Intelligence Platform with Replaceable Intelligence Layer",
  "scripts": {
    "dev:backend": "npm run dev --workspace=tg-backend",
    "dev:frontend": "npm run dev --workspace=tg-frontend",
    "build:backend": "npm run build --workspace=tg-backend",
    "build:frontend": "npm run build --workspace=tg-frontend",
    "build": "npm run build --workspace=tg-backend && npm run build --workspace=tg-frontend",
    "test": "npm test --workspace=tg-backend"
  },
  "dependencies": {
    "typescript": "^5.4.5",
    "express": "^4.19.2",
    "cors": "^2.8.5"
  },
  "keywords": [
    "trend-intelligence",
    "business-intelligence",
    "growth",
    "opportunity-engine",
    "ai-ready",
    "glassmorphism"
  ],
  "author": "GrowthWorks",
  "license": "MIT",
  "allowScripts": {
    "protobufjs": true,
    "@google/genai": true,
    "esbuild": true
  }
}
