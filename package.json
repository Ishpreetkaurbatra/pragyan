{
  "name": "t-to-g-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "description": "T→G (Trend to Growth) - Complete Full-Stack Business Intelligence Platform with Replaceable Intelligence Layer",
  "scripts": {
    "dev:backend": "npm run dev --workspace=tg-backend",
    "dev:frontend": "npm run dev --workspace=tg-frontend",
