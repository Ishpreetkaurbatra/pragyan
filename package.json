    "build:frontend": "cd frontend && npm run build",
    "build": "cd backend && npm run build && cd ../frontend && npm run build",
    "test": "npm test --workspace=tg-backend"
  },
  "dependencies": {
    "typescript": "^5.4.5"
  },
  "keywords": [
    "trend-intelligence",
    "business-intelligence",
    "growth",
    "opportunity-engine",
    "ai-ready",
    "glassmorphism"
  ],
